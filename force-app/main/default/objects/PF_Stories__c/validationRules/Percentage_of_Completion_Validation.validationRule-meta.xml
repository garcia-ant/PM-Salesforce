<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Percentage_of_Completion_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ), Percentage_of_Completion__c &lt; 0 || Percentage_of_Completion__c &gt; 1)</errorConditionFormula>
    <errorDisplayField>Percentage_of_Completion__c</errorDisplayField>
    <errorMessage>The Percentage of Completion field only accepts values from 0 to 100%</errorMessage>
</ValidationRule>
