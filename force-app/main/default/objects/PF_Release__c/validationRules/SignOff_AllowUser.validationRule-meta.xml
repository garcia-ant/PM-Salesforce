<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SignOff_AllowUser</fullName>
    <active>true</active>
    <description>Check if current user is allowed to sign-off the release</description>
    <errorConditionFormula>Sign_Off__c  = True &amp;&amp; PF_Project__r.Client_Sign_Off__c  &lt;&gt;  $User.Id</errorConditionFormula>
    <errorDisplayField>Sign_Off__c</errorDisplayField>
    <errorMessage>You are not allowed to sign-off the release.</errorMessage>
</ValidationRule>
