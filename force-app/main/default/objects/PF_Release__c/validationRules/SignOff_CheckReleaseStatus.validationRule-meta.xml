<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SignOff_CheckReleaseStatus</fullName>
    <active>true</active>
    <description>Check if release status is Completed</description>
    <errorConditionFormula>NOT(ISPICKVAL(PF_Release_Status__c, &quot;Completed&quot;)) &amp;&amp;  Sign_Off__c  = True</errorConditionFormula>
    <errorDisplayField>Sign_Off__c</errorDisplayField>
    <errorMessage>Release status must be &quot;Completed&quot; before sign-off</errorMessage>
</ValidationRule>
