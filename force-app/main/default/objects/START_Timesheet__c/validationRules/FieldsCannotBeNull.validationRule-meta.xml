<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FieldsCannotBeNull</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ), AND( OR(ISNULL(Description__c),ISNULL(Period_Date__c),ISPICKVAL(Status__c, &quot;&quot;) )  ,
ISNEW() ))</errorConditionFormula>
    <errorMessage>The fields status, description and date can not be empty</errorMessage>
</ValidationRule>
