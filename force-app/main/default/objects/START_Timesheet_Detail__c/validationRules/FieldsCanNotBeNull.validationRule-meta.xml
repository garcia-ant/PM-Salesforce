<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FieldsCanNotBeNull</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ),OR(ISPICKVAL(Country__c,&quot;&quot;),      ISNULL(Date__c),ISNULL(Duration_Hours__c),LEN(Lookup_WorkTask__c)=0 ))</errorConditionFormula>
    <errorMessage>The country, the duration, date and the task can not be null</errorMessage>
</ValidationRule>
