<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>redonly_fields</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ),
OR((ISCHANGED(Attendees__c )),
(ISCHANGED(Meeting_Date__c)),
(ISCHANGED(Description__c)),
(ISCHANGED(Governance_Report__c)),
(ISCHANGED(Name))))</errorConditionFormula>
    <errorMessage>It&apos;s not possible edit the meeting review</errorMessage>
</ValidationRule>
