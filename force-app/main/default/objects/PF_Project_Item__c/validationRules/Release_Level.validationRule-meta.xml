<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Release_Level</fullName>
    <active>true</active>
    <description>Release is mandatory if Level is selected as Release</description>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ), ISPICKVAL(PF_Level__c, &apos;Release&apos;) &amp;&amp; ISBLANK(PF_Release__c))</errorConditionFormula>
    <errorMessage>Please populate Release</errorMessage>
</ValidationRule>
