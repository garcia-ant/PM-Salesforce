<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Project_Level</fullName>
    <active>true</active>
    <description>Project is mandatory if Level is selected as Project</description>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ), ISPICKVAL(PF_Level__c, &apos;Project&apos;) &amp;&amp; ISBLANK(PF_Project__c))</errorConditionFormula>
    <errorMessage>Please populate Project</errorMessage>
</ValidationRule>
