<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Product_Level</fullName>
    <active>true</active>
    <description>Product is mandatory if Level is selected as Product</description>
    <errorConditionFormula>AND(NOT( $Setup.Org_Exceptions__c.Bypass_Validation_rules__c ), ISPICKVAL(PF_Level__c, &apos;Product&apos;) &amp;&amp; ISBLANK(PF_Product__c))</errorConditionFormula>
    <errorMessage>Please populate Product</errorMessage>
</ValidationRule>
